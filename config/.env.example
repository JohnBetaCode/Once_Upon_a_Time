# Gemini on Vertex AI
# Auth uses Application Default Credentials:
#   gcloud auth application-default login
# (docker-compose mounts ~/.config/gcloud into the container automatically)

GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_IMAGE_LOCATION=global

GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3-pro-image

# Image generation backend: "gemini" (default) or "local", an open-weights model served
# by the local-image Compose service on this machine's GPU (experimental; docs/setup.md).
IMAGE_BACKEND=gemini
LOCAL_IMAGE_URL=http://local-image:8000
