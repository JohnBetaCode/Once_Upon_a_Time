# Gemini on Vertex AI
# Auth uses Application Default Credentials:
#   gcloud auth application-default login
# (docker-compose mounts ~/.config/gcloud into the container automatically)

GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_IMAGE_LOCATION=global

GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3-pro-image

# Image generation: "gemini" (cloud, default) or "local", an open-weights model on this machine's
# NVIDIA GPU (start its server with ./launch.sh). Research always uses the Gemini text model.
IMAGE_BACKEND=gemini
# The local GPU server as seen from the app: the Compose service name. Use
# http://localhost:8600 when the app runs without Docker.
LOCAL_IMAGE_URL=http://local-image:8000

# Local GPU server settings, read by the local-image service. Restart it after a change:
#   docker compose --profile gpu up -d local-image
# Model; Qwen/Qwen-Image-2.1-Turbo also exists (untested here; pair it with LOCAL_IMAGE_STEPS=8).
# LOCAL_IMAGE_MODEL=Qwen/Qwen-Image-2.1
# LOCAL_IMAGE_STEPS=40
# Default output size, 1k (fast, the size Gemini returns) or 2k (native). Sheets always ask for 2k.
# LOCAL_IMAGE_SIZE=1k
# Unload the model after this many idle minutes to free ~25 GB of RAM (0 keeps it loaded).
# LOCAL_IMAGE_IDLE_MINUTES=20
# Load the model at start-up (1) or on the first image (0).
# LOCAL_IMAGE_PRELOAD=1
# Guidance above 1 enables the negative prompt, at ~1.6x the time per image.
# LOCAL_IMAGE_CFG=1.0
# "none" keeps the whole model on the GPU (needs ~40 GB of VRAM); "model" moves parts as needed.
# LOCAL_IMAGE_OFFLOAD=model
# Refuse to start on GPUs with less VRAM than this.
# LOCAL_IMAGE_MIN_VRAM_GB=24
# Folder for the model weights, shared by every project that runs this server (read by ./launch.sh
# when it creates the local-image-models volume; set the same value in every project). Empty:
# Docker's own storage. See "Where the models live" in docs/setup.md.
# LOCAL_IMAGE_MODELS_DIR=/data/models
